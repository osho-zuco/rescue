# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rescue_dev"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_ACCESS_EXPIRY="30d"
JWT_REFRESH_EXPIRY="90d"

# OTP Provider (msg91 or twilio)
OTP_PROVIDER="msg91"
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_TEMPLATE_ID="your-template-id"
# For Twilio (if using)
# TWILIO_ACCOUNT_SID="..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_VERIFY_SERVICE_SID="..."

# Firebase (for push notifications)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Sentry (optional, for error tracking)
SENTRY_DSN=""

# Mixpanel (optional, for analytics)
MIXPANEL_TOKEN=""

# Server
PORT=3000
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:8080"

# Geofence (optional - default 50 meters)
GEOFENCE_RADIUS_METERS=50
